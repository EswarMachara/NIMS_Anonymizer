# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/

# --- desktop_app: virtual environment (regenerate with `python -m venv venv`) ---
desktop_app/venv/

# --- desktop_app: PyInstaller build output (regenerated by `pyinstaller app.spec`;
# GitHub Actions builds this fresh and publishes it as a workflow artifact / release
# asset -- never commit a built .exe or its intermediate build cache to source control) ---
desktop_app/build/build/
desktop_app/build/dist/

# --- Reference checkout, not part of this repo ---
# The data-collection portal is cloned here only so its design system can be
# read while building the desktop app's UI. It is its own repository with its
# own history; committing it here would either nest a repo or duplicate
# someone else's code into this one.
/Renal-Data-Collection/

# --- Editor / OS cruft ---
.vscode/
.DS_Store
Thumbs.db

# ==========================================================================
# PATIENT DATA -- MUST NEVER BE COMMITTED
# ==========================================================================
# These are the folders operators drop real patient packages into. They
# contain unredacted PHI: real names, CR/Lab numbers, DICOM ultrasound
# images and clinical report PDFs. This repo is pushed to GitHub, so a
# single `git add -A` with these tracked would publish patient data
# irreversibly (deleting the commit afterwards does not un-publish it --
# it stays in forks, clones and caches).
/eGFR/
/KFRE/

# Defence in depth for patient files dumped anywhere else in the tree
# (a scratch folder, a copied package, an operator's test run). There is
# no legitimate reason for any of these to be in version control.
*.dcm
*.DCM
*.pdf
*.PDF

# NOTE: the *.pdf rule above is deliberately broad because KFRE packages
# are PDF-only, so an unignored PDF is a plausible PHI leak. If you ever
# genuinely need to commit a NON-patient PDF (a spec, a form template),
# add it explicitly and knowingly:  git add -f path/to/doc.pdf

# --- App runtime data (never applicable inside the repo, but guards against an
# accidental local run writing here instead of %LOCALAPPDATA%) ---
Anonymized_eGFR/
Anonymized_KFRE/
*_anony_Mapping.csv
# The repeat-submission ledger that travels with the mapping CSV. Records the
# ORIGINAL filename of every file already anonymized, which in a hospital's
# own naming can carry patient names -- same confidentiality class as the CSV.
*_processed_files.json

# Transient artifact of desktop_app/build/ui_preview.py
desktop_app/web/_ui_preview.html
